# ==========================================
# TaskFlow Server Configuration
# ==========================================
PORT=3000

# ==========================================
# Supabase Configuration
# ==========================================
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key: Safe to expose to client-side for initial Supabase client initialization
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Service Role Key (SERVER-ONLY - CRITICAL SECURITY):
# This key has full administrative access and bypasses Row Level Security (RLS).
# MUST NEVER be exposed in frontend JavaScript or committed to version control.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here
